# memory-system — environment template.
#
#   cp infra/.env.example infra/.env      # then fill in the values
#
# infra/.env is gitignored and is the ONLY place real secrets live.
# This file must always carry the same variable names with EMPTY values.

# --- datastores ------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Admin/owner DSN. Used by `python -m store.migrate` only.
# Port must match POSTGRES_HOST_PORT below.
DATABASE_URL=
REDIS_URL=

# --- host port mappings ----------------------------------------------------
# Defaults in docker-compose.yml are 55432 / 56379 because this machine runs a
# native PostgreSQL service on 5432 and a native Memurai (Redis) service on
# 6379. Set these back to 5432 / 6379 once those native services are stopped.
POSTGRES_HOST_PORT=
REDIS_HOST_PORT=
MINIO_HOST_PORT=
MINIO_CONSOLE_HOST_PORT=
PROMETHEUS_HOST_PORT=
GRAFANA_HOST_PORT=

# --- application database role (RLS) ---------------------------------------
# The app NEVER connects as the owner/superuser: PostgreSQL superusers bypass
# row-level security entirely, so RLS would silently do nothing. Migration
# 0004_rls.sql creates this non-superuser, non-owner role and grants it only
# DML on the three tables. Leave APP_DATABASE_URL blank to have store/db.py
# derive it from DATABASE_URL by swapping in APP_DB_USER/APP_DB_PASSWORD.
APP_DB_USER=
APP_DB_PASSWORD=
APP_DATABASE_URL=

# --- object store ----------------------------------------------------------
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- observability ---------------------------------------------------------
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# --- models (see harness.md D1 / D2) ---------------------------------------
# Completions: Groq. gpt-oss spends budget on reasoning tokens before emitting
# content, so LLM_MAX_TOKENS must stay >= 512 or `content` comes back empty
# with finish_reason=stop.
LLM_MODEL=
LLM_FALLBACK_MODEL=
LLM_MAX_TOKENS=
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=
GROQ_API_KEY=

# Embeddings: Voyage. Groq exposes no embeddings endpoint.
# EMBEDDING_DIM is templated into the memories.embedding vector(N) column at
# migration time — it is never hardcoded in the .sql files.
EMBEDDING_MODEL=
EMBEDDING_DIM=
VOYAGE_API_KEY=

# --- app -------------------------------------------------------------------
API_HOST=
API_PORT=
LOG_LEVEL=
