# Copy to .env.local and restart the dev server.
#
# Base URL of the FastAPI backend (start it with `python -m api.main`).
# Read server-side only, by app/api/chat/route.ts.
#
# Note the absence of a NEXT_PUBLIC_ prefix: that is deliberate. Next inlines
# NEXT_PUBLIC_* variables into the browser bundle, which would publish the
# internal backend URL. Without the prefix it stays on the server.
#
# Nothing secret belongs in this file or anywhere else under frontend/ --
# this app is served to a browser, so treat every file here as public.
API_BASE_URL=http://localhost:8000
